generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator pothos {
  provider = "prisma-pothos-types"
  output   = "../src/generated/pothos-types.ts"
}

datasource db {
  provider = "postgresql"
}

model Film {
  id          String   @id
  title       String
  description String
  tagline     String
  director    String
  releaseDate String   @map("release_date")
  runtime     String
  image       String
  banner      String
  score       String
  trivia      String[]
  languages   String[]

  translations FilmTranslation[]

  @@map("film")
}

// Per-locale copy for a film. One row per (film, locale); English is stored as a
// row too, so it isn't a special case. Coverage is uneven by design — a film only
// has rows for the locales it's actually translated into. Locale-invariant fields
// (image, score, runtime, etc.) stay on `Film` and are not duplicated here.
model FilmTranslation {
  filmId      String   @map("film_id")
  locale      String
  title       String
  tagline     String
  description String
  trivia      String[]

  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@id([filmId, locale])
  @@map("film_translation")
}
