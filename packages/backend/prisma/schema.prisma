generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator pothos {
  provider = "prisma-pothos-types"
  output   = "../src/generated/pothos-types.ts"
}

datasource db {
  provider = "postgresql"
}

model Film {
  id          String   @id
  title       String
  description String
  tagline     String
  director    String
  releaseDate String   @map("release_date")
  runtime     String
  image       String
  banner      String
  score       String
  trivia      String[]
  languages   String[]

  @@map("film")
}
